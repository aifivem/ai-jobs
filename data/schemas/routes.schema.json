{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-jobs/data/routes.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "ped": {
          "type": "object",
          "properties": {
            "model": {
              "description": "Model: The ped model; empty means no NPC. Players see it within 50 m.",
              "type": "string",
              "maxLength": 64
            },
            "scenario": {
              "description": "What it does: An idle animation the NPC plays on the spot.",
              "enum": [
                "",
                "WORLD_HUMAN_STAND_IMPATIENT",
                "WORLD_HUMAN_CLIPBOARD",
                "WORLD_HUMAN_STAND_MOBILE",
                "WORLD_HUMAN_AA_COFFEE",
                "WORLD_HUMAN_SMOKING",
                "WORLD_HUMAN_GUARD_STAND",
                "WORLD_HUMAN_COP_IDLES",
                "WORLD_HUMAN_HANG_OUT_STREET"
              ]
            },
            "coords": {
              "description": "Where it stands: The NPC's floor spot and the way it faces (scroll in the free camera); without one it stands on the place's point.",
              "type": "object",
              "required": [
                "x",
                "y",
                "z",
                "heading"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "heading": {
                  "type": "number"
                }
              }
            }
          },
          "required": []
        },
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "kind": {
          "description": "Kind: Random: the next stop is any other stop (taxi, trucker, news). In order: stops one after the other (bus). Gather: on foot, items at each stop. Towing: a broken-down car waits at the stop, load it and bring it to the depot.",
          "enum": [
            "ordered",
            "random",
            "gather",
            "tow"
          ]
        },
        "job": {
          "description": "Needed job: Empty: anyone can work here.",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "depot": {
          "description": "Depot: Where players start and stop working.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "vehicle": {
          "description": "Vehicle model: Spawn name (taxi, bus, mule, trash). Empty: no vehicle.",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "spawn": {
          "description": "Vehicle spawn",
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "heading"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            }
          }
        },
        "pay": {
          "description": "Pay per stop: Paid to the bank after each stop.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "seconds": {
          "description": "Time per stop: How long the work at a stop takes.",
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "item": {
          "description": "Item per stop: Given at each stop, as many as the counts below.",
          "type": "string",
          "minLength": 0,
          "maxLength": 48
        },
        "stops": {
          "description": "Stops per shift: 0 means the shift goes on until the player stops.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "gatherMin": {
          "description": "Fewest items per stop",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "gatherMax": {
          "description": "Most items per stop: Each stop gives a random count between the two.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "towModels": {
          "description": "Broken-down cars: Spawn names of the cars that wait at the stops; one is picked at random.",
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "blip": {
          "description": "Depot blip",
          "type": "object",
          "properties": {
            "sprite": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "color": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "scale": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 2
            }
          },
          "required": [
            "sprite",
            "color",
            "scale"
          ]
        }
      },
      "required": [
        "label",
        "kind",
        "job",
        "depot",
        "vehicle",
        "spawn",
        "pay",
        "seconds",
        "item",
        "stops"
      ]
    }
  },
  "additionalProperties": false
}
